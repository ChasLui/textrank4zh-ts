{
  "name": "textrank4zh-ts",
  "version": "0.2.3",
  "description": "适用于中文文本关键词提取和摘要生成的 TextRank 算法 TypeScript 实现（兼容浏览器）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:browser": "npm run build && npm run serve",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "serve": "python3 -m http.server 8000 -d examples/browser || python -m SimpleHTTPServer 8000",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major"
  },
  "keywords": [
    "textrank",
    "chinese",
    "nlp",
    "keyword-extraction",
    "text-summarization",
    "pagerank",
    "typescript",
    "browser",
    "segmentation"
  ],
  "author": "ChasLui <chaslui@outlook.com>",
  "license": "MIT",
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "release-it": "^19.0.4",
    "typescript": "^5.0.0",
    "unbuild": "^2.0.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChasLui/textrank4zh-ts.git"
  },
  "bugs": {
    "url": "https://github.com/ChasLui/textrank4zh-ts/issues"
  },
  "homepage": "https://github.com/ChasLui/textrank4zh-ts#readme",
  "sideEffects": false,
  "dependencies": {
    "typescript-result": "^3.5.2"
  },
  "volta": {
    "node": "22.18.0",
    "pnpm": "10.15.0"
  }
}
